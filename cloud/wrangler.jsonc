{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "budget-tracker",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // express/body-parser pull iconv-lite 0.4, whose browser field breaks the workerd bundle
  "alias": { "iconv-lite": "./node_modules/iconv-lite" },
  "assets": {
    "directory": "../web/dist/web/browser",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [
      { "name": "BUDGET", "class_name": "BudgetObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BudgetObject"] }
  ],
  "vars": {
    "HOSTED": "1",
    "MIGRATION_ENABLED": "0",
    "RECOVERY_ENABLED": "0"
  },
  "env": {
    "preview": {
      "name": "budget-tracker-preview",
      "workers_dev": true,
      "durable_objects": {
        "bindings": [
          { "name": "BUDGET", "class_name": "BudgetObject" }
        ]
      },
      "vars": {
        "HOSTED": "1",
        "MIGRATION_ENABLED": "0",
        "RECOVERY_ENABLED": "0",
        "PREVIEW_SEED": "1"
      }
    }
  }
}
