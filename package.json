{
  "name": "budget-tracker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "sync": "pnpm --filter server run sync --",
    "import": "pnpm --filter server run import",
    "demo:seed": "pnpm --filter server run demo",
    "demo": "node scripts/demo.mjs",
    "test:demo": "node --test scripts/demo.test.mjs",
    "cloud:check": "pnpm --filter cloud check",
    "cloud:deploy": "pnpm --filter cloud run deploy",
    "cloud:migrate": "node scripts/cloud-migrate.mjs",
    "cloud:snapshot": "node scripts/cloud-snapshot.mjs",
    "cloud:recover": "node scripts/cloud-recover.mjs",
    "cloud:preview": "pnpm --filter cloud preview",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "~6.0.3"
  }
}
